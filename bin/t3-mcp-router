#!/usr/bin/env node
"use strict";
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawn } = require("node:child_process");
const http = require("node:http");
const https = require("node:https");
const crypto = require("node:crypto");
const HOME_DIR = process.env.HOME || os.homedir();
const HUB_DIR = process.env.T3_HUB_DIR || path.join(HOME_DIR, ".t3", "hub");
const STATE_PATH = path.join(HUB_DIR, "state.json");
const REGISTRY_PATH = path.join(HUB_DIR, "mcp-registry.json");
const SCHEMA_CACHE_PATH = path.join(HUB_DIR, "mcp-schema-cache.json");
const IDLE_MS = 3 * 60 * 1000;
const MAX_BUFFER_BYTES = 2 * 1024 * 1024;
const SKILL_READ_MAX_BYTES = 64 * 1024;
let memoryAccess = null;
for (const cand of [
  process.env.T3_HUB_MEMORY_ACCESS ? path.resolve(process.env.T3_HUB_MEMORY_ACCESS) : null,
  path.join(__dirname, "..", "src", "hub-memory-access.cjs"),
  path.join(__dirname, "..", "hud-plugin", "hub-memory-access.cjs"),
  path.join(HOME_DIR, ".t3", "hud-plugin", "hub-memory-access.cjs"),
].filter(Boolean)) {
  try { memoryAccess = require(cand).createMemoryAccessManager({ homeDir: HOME_DIR, hubDir: HUB_DIR, userDataDir: process.env.T3CODE_HOME || path.join(HOME_DIR, ".t3", "userdata") }); break; } catch {}
}
const MEMORY_ONLY_MODE = process.argv.includes("--memory-only");

function memoryAccessStatus() {
  try { return memoryAccess ? memoryAccess.readMemoryOnlyStatus() : { ok: false, enabled: false, state: "unknown", serverVersion: "1", vaultAvailable: false }; }
  catch { return { ok: false, enabled: false, state: "unknown", serverVersion: "1", vaultAvailable: false }; }
}
function agentMemoryEnabled() { return memoryAccessStatus().state === "enabled"; }
function isMemoryTool(name) { return typeof name === "string" && name.startsWith("memory_") && name !== "memory_status"; }

let memoryVault = null;
let memoryVaultLoaded = false;
function getMemoryVault() {
  if (memoryVaultLoaded) return memoryVault;
  memoryVaultLoaded = true;
  for (const cand of [
    process.env.T3_MEMORY_VAULT ? path.resolve(process.env.T3_MEMORY_VAULT) : null,
    path.join(__dirname, "..", "src", "memory-vault.cjs"),
    path.join(__dirname, "..", "hud-plugin", "memory-vault.cjs"),
    path.join(HOME_DIR, ".t3", "hud-plugin", "memory-vault.cjs"),
  ].filter(Boolean)) {
    try { memoryVault = require(cand); if (memoryVault) break; } catch {}
  }
  return memoryVault;
}

function readJson(p, fb) { try { return JSON.parse(fs.readFileSync(p, "utf8")); } catch { return fb; } }
function readState() { const s = readJson(STATE_PATH, {}); return s && typeof s === "object" ? s : {}; }
function readRegistry() {
  const r = readJson(REGISTRY_PATH, []);
  if (Array.isArray(r)) return r;
  if (r && typeof r === "object" && Array.isArray(r.servers)) return r.servers;
  if (r && typeof r === "object" && r.mcpServers && typeof r.mcpServers === "object") return Object.entries(r.mcpServers).map(([name, v]) => ({ name, ...(v || {}) }));
  if (r && typeof r === "object") return Object.entries(r).map(([name, v]) => ({ name, ...(v || {}) }));
  return [];
}
function dirExistsBin(p) { try { return fs.statSync(p).isDirectory(); } catch { return false; } }
function listDirsBin(dir) {
  try { return fs.readdirSync(dir, { withFileTypes: true }).filter((e) => e.isDirectory() || e.isSymbolicLink()).map((e) => path.join(dir, e.name)); } catch { return []; }
}
function skillFileExists(p) { try { return fs.statSync(p).isFile(); } catch { return false; } }
function canonicalProjectRoot(root) {
  if (typeof root !== "string" || !root || !path.isAbsolute(root)) return null;
  const absolute = path.resolve(root);
  try { return fs.realpathSync(absolute); } catch { return absolute; }
}
function hasSymlinkComponent(root) {
  if (typeof root !== "string" || !path.isAbsolute(root)) return true;
  const absolute = path.resolve(root), parsed = path.parse(absolute);
  let current = parsed.root;
  for (const part of absolute.slice(parsed.root.length).split(path.sep).filter(Boolean)) {
    current = path.join(current, part);
    try { if (fs.lstatSync(current).isSymbolicLink()) return true; }
    catch (error) { if (error?.code !== "ENOENT") return true; break; }
  }
  return false;
}
function projectModeKeys(projects, root) {
  const canonical = canonicalProjectRoot(root);
  if (!canonical) return [];
  const aliases = Object.keys(projects || {}).filter((key) => !hasSymlinkComponent(key) && canonicalProjectRoot(key) === canonical).sort();
  return [...new Set([canonical, ...aliases])];
}
function modeFor(modes, name) {
  if (!modes || typeof modes !== "object") return undefined;
  if (Object.prototype.hasOwnProperty.call(modes, name)) return modes[name];
  const matches = Object.keys(modes).filter((key) => normModeKey(key) === normModeKey(name));
  return matches.length === 1 ? modes[matches[0]] : undefined;
}
function normModeKey(name) { return String(name).toLowerCase().replace(/_/g, "-"); }
function projectModeFor(projects, root, name) {
  for (const key of projectModeKeys(projects, root)) {
    const mode = modeFor(projects?.[key], name);
    if (mode !== undefined) return mode;
  }
  return undefined;
}
function parseSkillMeta(skillFile) {
  let raw = "";
  try { raw = fs.readFileSync(skillFile, "utf8"); } catch { return { name: "", description: "" }; }
  let name = "", description = "";
  const fm = raw.match(/^---\r?\n([\s\S]*?)\r?\n---/);
  if (fm) {
    const block = fm[1];
    const nd = block.match(/^name:\s*(.+)$/m);
    const dd = block.match(/^description:\s*(.+)$/m);
    if (nd) name = nd[1].trim().replace(/^["']|["']$/g, "");
    if (dd) description = dd[1].trim().replace(/^["']|["']$/g, "");
  }
  if (!description) {
    const body = fm ? raw.slice(fm[0].length) : raw;
    for (const line of body.split("\n")) {
      const t = line.trim();
      if (t && !t.startsWith("#")) { description = t.slice(0, 200); break; }
    }
  }
  if (!name) {
    const h = raw.match(/^#\s*(.+)$/m);
    if (h) name = h[1].trim().slice(0, 80);
  }
  return { name, description };
}
function findSkillDirsRecursive(root, maxDepth = 4) {
  const out = [];
  if (!dirExistsBin(root)) return out;
  const stack = [{ dir: root, depth: 0 }];
  while (stack.length) {
    const { dir, depth } = stack.pop();
    let entries = [];
    try { entries = fs.readdirSync(dir, { withFileTypes: true }); } catch { continue; }
    for (const ent of entries) {
      if (!ent.isDirectory() && !ent.isSymbolicLink()) continue;
      const full = path.join(dir, ent.name);
      if (skillFileExists(path.join(full, "SKILL.md"))) out.push(full);
      if (depth < maxDepth) stack.push({ dir: full, depth: depth + 1 });
    }
  }
  return out;
}
function discoverSkills(projectRoot) {
  const roots = [
    path.join(HUB_DIR, "skills"),
    path.join(HUB_DIR, "packages"),
    path.join(HOME_DIR, ".agents", "skills"),
    path.join(HOME_DIR, ".zcode", "skills"),
    path.join(HOME_DIR, ".claude", "skills"),
    path.join(HOME_DIR, ".config", "muse", "skills"),
    path.join(HOME_DIR, ".pi", "agent", "skills"),
    path.join(HOME_DIR, ".codex", "skills"),
  ];
  try {
    const agyRoot = path.join(HOME_DIR, ".t3", "userdata", "providers", "antigravity");
    for (const inst of listDirsBin(agyRoot)) roots.push(path.join(inst, "config", "skills"));
  } catch {}
  if (projectRoot) {
    roots.push(path.join(projectRoot, ".agents", "skills"));
    roots.push(path.join(projectRoot, ".claude", "skills"));
    roots.push(path.join(projectRoot, ".codex", "skills"));
  }
  const byId = new Map();
  function addDir(dir) {
    try {
      if (!skillFileExists(path.join(dir, "SKILL.md"))) return;
      const id = path.basename(dir);
      if (!id || id.startsWith(".")) return;
      const meta = parseSkillMeta(path.join(dir, "SKILL.md"));
      byId.set(id, { id, name: meta.name || id, description: meta.description || "", dir, path: path.join(dir, "SKILL.md") });
    } catch {}
  }
  for (const root of roots) {
    if (!dirExistsBin(root)) continue;
    const isPackages = root.endsWith("packages");
    if (isPackages) {
      for (const d of listDirsBin(root)) addDir(d);
      for (const d of findSkillDirsRecursive(root, 4)) addDir(d);
    } else {
      for (const d of listDirsBin(root)) addDir(d);
    }
  }
  return [...byId.values()].sort((a, b) => a.id.localeCompare(b.id));
}
function findSkill(slug, projectRoot) {
  if (typeof slug !== "string" || !slug.trim()) throw new Error("skill slug required");
  const s = slug.trim();
  if (s.includes("/") || s.includes("\\") || s.includes("..") || path.isAbsolute(s)) throw new Error("invalid skill slug: " + slug);
  const skills = discoverSkills(projectRoot);
  let found = skills.find((x) => x.id === s);
  if (found) return found;
  found = skills.find((x) => x.id.toLowerCase() === s.toLowerCase());
  if (found) return found;
  found = skills.find((x) => x.name === s);
  if (found) return found;
  throw new Error("skill not found: " + slug);
}
function readSkillFileLimited(dir, filePath, maxBytes) {
  const st = fs.statSync(filePath);
  if (!st.isFile()) throw new Error("not a file: " + filePath);
  const truncated = st.size > maxBytes;
  let buf;
  if (truncated) {
    const fd = fs.openSync(filePath, "r");
    try {
      buf = Buffer.alloc(maxBytes);
      const n = fs.readSync(fd, buf, 0, maxBytes, 0);
      buf = buf.subarray(0, n);
    } finally { fs.closeSync(fd); }
  } else {
    buf = fs.readFileSync(filePath);
  }
  return { content: buf.toString("utf8"), truncated, size: st.size };
}
function discoveredDefs() {
  try {
    const cands = [
      process.env.T3_MCP_ROUTER ? path.resolve(process.env.T3_MCP_ROUTER) : null,
      path.join(__dirname, "..", "src", "mcp-router.cjs"),
      path.join(__dirname, "..", "hud-plugin", "mcp-router.cjs"),
      path.join(HOME_DIR, ".t3", "hud-plugin", "mcp-router.cjs"),
    ].filter(Boolean);
    for (const c of cands) {
      try {
        const mod = require(c);
        if (!mod) continue;
        let m = null;
        if (typeof mod.discoverServerDefinitions === "function") {
          try { m = mod.discoverServerDefinitions({ homeDir: HOME_DIR, hubDir: HUB_DIR }); } catch {
            try {
              if (typeof mod.createMcpRouter === "function") {
                const r = mod.createMcpRouter({ homeDir: HOME_DIR, hubDir: HUB_DIR });
                if (r && typeof r.discoverServerDefinitions === "function") m = r.discoverServerDefinitions();
              }
            } catch {}
          }
        } else if (typeof mod.createMcpRouter === "function") {
          try {
            const r = mod.createMcpRouter({ homeDir: HOME_DIR, hubDir: HUB_DIR });
            if (r && typeof r.discoverServerDefinitions === "function") m = r.discoverServerDefinitions();
          } catch {}
        }
        if (m) {
          const map = new Map();
          if (m instanceof Map) { for (const [k, v] of m) map.set(k, v); }
          else if (Array.isArray(m)) { for (const v of m) if (v && v.name) map.set(v.name, v); }
          else if (m && typeof m === "object") { for (const [k, v] of Object.entries(m)) map.set(v && v.name ? v.name : k, v); }
          if (map.size) return map;
        }
      } catch {}
    }
  } catch {}
  const byName = new Map();
  function add(s) { if (!s || !s.name || s.name === "t3_hub" || s.name === "t3-hub") return; if (!byName.has(s.name)) byName.set(s.name, s); }
  try {
    const magpie = readJson(path.join(HOME_DIR, ".config", "magpie", "library.json"), null);
    if (magpie && Array.isArray(magpie.mcp)) {
      for (const e of magpie.mcp) if (e && e.name) add({ name: e.name, transport: e.transport || (e.url ? "http" : "stdio"), command: e.command, args: e.args, env: e.env, url: e.url, agents: e.agents, __source: "magpie", __sourceLabel: "magpie" });
    }
    function collect(file, key) {
      const raw = readJson(file, null);
      if (!raw || !raw.mcpServers || typeof raw.mcpServers !== "object" || Array.isArray(raw.mcpServers)) return;
      for (const [name, v] of Object.entries(raw.mcpServers)) { if (name === "t3_hub" || name === "t3-hub") continue; add({ name, ...(v || {}), __source: key, __sourceLabel: key }); }
    }
    collect(path.join(HOME_DIR, ".pi", "agent", "mcp.json"), "pi");
    collect(path.join(HOME_DIR, ".config", "muse", "settings.json"), "muse");
    collect(path.join(HOME_DIR, ".claude", "mcp.json"), "claude");
    const agyRoot = path.join(HOME_DIR, ".t3", "userdata", "providers", "antigravity");
    if (dirExistsBin(agyRoot)) for (const inst of listDirsBin(agyRoot)) collect(path.join(inst, "config", "mcp_config.json"), "agy");
  } catch {}
  return byName;
}
function resolveProjectRoot() {
  let cur = canonicalProjectRoot(process.cwd()) || path.resolve(process.cwd());
  const state = readState();
  const registered = new Set(Object.keys(state.mcpModes?.projects || {}).filter((key) => !hasSymlinkComponent(key)).map(canonicalProjectRoot).filter(Boolean));
  let fallback = cur;
  while (true) {
    try {
      const st = fs.statSync(path.join(cur, ".git"));
      if (st.isDirectory() || st.isFile()) return canonicalProjectRoot(cur) || cur;
    } catch {}
    if (registered.has(canonicalProjectRoot(cur))) return canonicalProjectRoot(cur) || cur;
    const parent = path.dirname(cur);
    if (parent === cur) return canonicalProjectRoot(fallback) || fallback;
    cur = parent;
    if (cur === path.parse(cur).root) break;
  }
  return canonicalProjectRoot(fallback) || fallback;
}
function enabledServers() {
  const registry = readRegistry();
  const state = readState();
  const projectRoot = resolveProjectRoot();
  const globalModes = state.mcpModes?.global || {};
  const projectModes = state.mcpModes?.projects || {};
  const discovered = discoveredDefs();
  const merged = new Map();
  for (const [k, v] of discovered) merged.set(k, v);
  for (const s of registry) { if (s && s.name) merged.set(s.name, s); }
  const namesByModeKey = new Map();
  for (const s of merged.values()) {
    if (!s || !s.name) continue;
    const key = normModeKey(s.name);
    if (!namesByModeKey.has(key)) namesByModeKey.set(key, new Set());
    namesByModeKey.get(key).add(s.name);
  }
  const out = [];
  for (const s of merged.values()) {
    if (!s || !s.name) continue;
    if (s.modeConflict || (namesByModeKey.get(normModeKey(s.name))?.size || 0) > 1) continue;
    const projectMode = projectModeFor(projectModes, projectRoot, s.name);
    const globalMode = modeFor(globalModes, s.name);
    const mode = projectMode !== undefined ? projectMode : globalMode !== undefined ? globalMode : "off";
    if (mode === "off") continue;
    out.push({ def: s, mode });
  }
  return { servers: out, projectRoot };
}
function vaultFn(...names) {
  const vault = getMemoryVault();
  if (!vault) return null;
  for (const n of names) if (typeof vault[n] === "function") return (...a) => vault[n](...a);
  return null;
}
const vaultSearch = memoizeVault(["search", "memorySearch", "memory_search", "recall", "listMemories"]);
function compactMemorySearchItem(item) {
  if (!item || typeof item !== "object" || Array.isArray(item)) return item;
  const { history, ...current } = item;
  return current;
}
function compactMemorySearchResult(result) {
  if (Array.isArray(result)) return result.map(compactMemorySearchItem);
  if (!result || typeof result !== "object") return result;
  if (Array.isArray(result.items)) return { ...result, items: result.items.map(compactMemorySearchItem) };
  // Preserve legacy vault adapters that return MCP text-wrapped JSON while
  // keeping search and explicit memory_read revision history separate.
  if (Array.isArray(result.content)) {
    let changed = false;
    const content = result.content.map((entry) => {
      if (!entry || typeof entry.text !== "string") return entry;
      try {
        const decoded = JSON.parse(entry.text);
        const compact = compactMemorySearchResult(decoded);
        if (compact === decoded) return entry;
        changed = true;
        return { ...entry, text: JSON.stringify(compact) };
      } catch { return entry; }
    });
    return changed ? { ...result, content } : result;
  }
  return result;
}
const vaultRead = (...args) => {
  const memoryVault = getMemoryVault();
  const fn = vaultFn("read", "memoryRead", "memory_read");
  if (fn) return fn(...args);
  if (memoryVault && typeof memoryVault.listMemories === "function") {
    const a = args[0] || {};
    const listArgs = { projectRoot: a.projectRoot, module: a.module || "all", includeGlobal: a.includeGlobal !== false, id: a.id, scope: a.scope, scopeFilter: a.scopeFilter };
    const res = memoryVault.listMemories({ ...listArgs, limit: a.id ? 1 : 200 });
    if (a.id && res && Array.isArray(res.items)) {
      const found = res.items.find((it) => it.id === a.id);
      if (found) return { ok: true, projectSlug: res.projectSlug, item: found };
      // Older adapters may ignore the new id filter. Retry within the same
      // bounded project/scope listing so existing adapters remain compatible.
      const { id, ...legacyArgs } = listArgs;
      const legacy = memoryVault.listMemories({ ...legacyArgs, limit: 200 });
      const legacyFound = legacy && Array.isArray(legacy.items)
        ? legacy.items.find((it) => it.id === a.id)
        : null;
      return { ok: Boolean(legacyFound), projectSlug: legacy && legacy.projectSlug || res.projectSlug, item: legacyFound || null };
    }
    return res;
  }
  throw new Error("memory-vault function not found: read");
};
const vaultWrite = memoizeVault(["write", "memoryWrite", "memory_write", "saveMemory"]);
const vaultConsolidate = memoizeVault(["consolidateMemories"]);
const vaultRollback = memoizeVault(["rollbackMemory"]);
let hubSubagentsMod = null;
for (const cand of [
  path.join(__dirname, "..", "src", "hub-subagents.cjs"),
  path.join(__dirname, "..", "hud-plugin", "hub-subagents.cjs"),
