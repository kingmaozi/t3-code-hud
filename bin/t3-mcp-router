      { name: "memory_consolidate", description: "Consolidate overlapping unprotected project memories, or preview candidate pairs with dryRun. Pinned/core and secret-bearing entries are always excluded.", inputSchema: { type: "object", properties: { projectRoot: { type: "string" }, projectSlug: { type: "string" }, dryRun: { type: "boolean" } } } },
