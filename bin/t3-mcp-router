].filter(Boolean)) {
  try { hubTaskBoardMod = require(cand); if (hubTaskBoardMod) break; } catch {}
}
function getTaskBoard() {
  if (!hubTaskBoardMod) return null;
  if (typeof hubTaskBoardMod.createTaskBoard === "function") {
    // Respect HUB_DIR / HOME isolation for tests
    const hubPlansDir = path.join(HUB_DIR, "task-plans");
    const t3DbPath = path.join(HOME_DIR, ".t3", "userdata", "statev2.sqlite");
    try { return hubTaskBoardMod.createTaskBoard({ hubPlansDir, t3DbPath }); } catch { return hubTaskBoardMod.createTaskBoard({}); }
  }
  return hubTaskBoardMod;
}
function memoizeVault(names) {
  let cached;
  let tried = false;
  return (...args) => {
    if (!tried) { tried = true; cached = vaultFn(...names); }
    if (!cached) throw new Error("memory-vault function not found: " + names[0]);
    return cached(...args);
  };
}
