  if (hubSubagentsMod && typeof hubSubagentsMod.resolveSubagentRoute === "function") {
    tools.push({ name: "subagent_resolve", description: "Resolve live sub-agent provider/model/effort route from ~/.t3/hub/subagents.json + project overrides before delegate_task.", inputSchema: { type: "object", properties: { idOrTitle: { type: "string" }, role: { type: "string" }, projectRoot: { type: "string" } } } });
  }
  // plan_update is available even without memoryVault for Pi/general hosts
  if (hubTaskBoardMod) {
