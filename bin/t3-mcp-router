const HUB_LIST_DEF = { name: "hub_list_mcp_tools", description: "List tools from lazy upstream MCP servers (connects on demand).", inputSchema: { type: "object", properties: { server: { type: "string" } } } };
const HUB_CALL_DEF = { name: "hub_call_mcp_tool", description: "Invoke a tool on an upstream MCP server.", inputSchema: { type: "object", properties: { server: { type: "string" }, tool: { type: "string" }, arguments: { type: "object" } }, required: ["server", "tool"] } };

const stdioPool = new Map();
function stableJson(value) {
  if (Array.isArray(value)) return "[" + value.map(stableJson).join(",") + "]";
  if (value && typeof value === "object") {
    return "{" + Object.keys(value).sort().map((key) => JSON.stringify(key) + ":" + stableJson(value[key])).join(",") + "}";
  }
  return JSON.stringify(value);
}
function stdioDefinition(def, projectRoot = resolveProjectRoot(), validate = true) {
  const root = path.resolve(projectRoot || process.cwd());
  let cwd = root;
  if (def.cwd !== undefined && def.cwd !== null && def.cwd !== "") {
    if (typeof def.cwd !== "string") {
      if (validate) throw new Error("invalid cwd for " + def.name);
      cwd = def.cwd;
    } else {
      const configured = def.cwd.replace(/^~(?=\/)/, HOME_DIR);
      cwd = path.resolve(root, configured);
    }
  }
  if (validate) {
    if (typeof cwd !== "string") throw new Error("invalid cwd for " + def.name);
    let stat;
    try { stat = fs.statSync(cwd); } catch { throw new Error("cwd directory does not exist for " + def.name); }
    if (!stat.isDirectory()) throw new Error("cwd is not a directory for " + def.name);
    try { cwd = fs.realpathSync(cwd); } catch { throw new Error("cwd directory is unavailable for " + def.name); }
  } else if (typeof cwd === "string") {
    try { cwd = fs.realpathSync(cwd); } catch {}
  }
  return { ...def, cwd, args: Array.isArray(def.args) ? def.args : [] };
}
function definitionFingerprint(def, projectRoot = resolveProjectRoot()) {
  const effective = def.url ? { ...def } : stdioDefinition(def, projectRoot, false);
  const payload = {
    name: effective.name,
    transport: effective.transport || (effective.url ? "http" : "stdio"),
    command: effective.command || null,
    args: Array.isArray(effective.args) ? effective.args : [],
    url: effective.url || null,
    env: effective.env && typeof effective.env === "object" ? effective.env : {},
    headers: effective.headers && typeof effective.headers === "object" ? effective.headers : {},
    cwd: effective.url ? (effective.cwd || null) : effective.cwd,
  };
  const hash = crypto.createHash("sha256").update(stableJson(payload)).digest("hex");
  return { effective, hash };
}
function isWritableUpstream(entry) {
  const proc = entry.proc;
  return !entry.closed && !proc.killed && proc.exitCode === null &&
    proc.stdin && !proc.stdin.destroyed && proc.stdin.writable;
}
function closePoolEntry(entry, error) {
  entry.closed = true;
  entry.initialized = false;
  entry.initPromise = null;
  clearTimeout(entry.idleTimer);
  if (stdioPool.get(entry.key) === entry) stdioPool.delete(entry.key);
  for (const reject of [...entry.writes]) reject(error);
  for (const [id, waiter] of entry.waiters) {
    entry.waiters.delete(id);
    waiter.reject(error);
  }
}
function killPoolEntry(key, expectedEntry) {
  const e = stdioPool.get(key);
  if (!e || (expectedEntry && e !== expectedEntry)) return;
  closePoolEntry(e, new Error("upstream killed"));
  try { e.proc.kill("SIGTERM"); } catch {}
  const killer = setTimeout(() => {
    try {
      if (e.proc.exitCode === null && e.proc.signalCode == null) e.proc.kill("SIGKILL");
    } catch {}
  }, 100);
  if (killer.unref) killer.unref();
}
function retireStdioEntries(name, exceptKey) {
  for (const [key, entry] of stdioPool) {
    if (entry.name === name && key !== exceptKey) killPoolEntry(key, entry);
  }
}
function prepareStdioDefinition(def, projectRoot, fingerprint) {
  try { return { effective: stdioDefinition(fingerprint.effective, projectRoot, true), hash: fingerprint.hash }; }
  catch (error) {
    retireStdioEntries(def.name);
    throw error;
  }
}
function prepareUpstreamDefinition(def, projectRoot) {
  const fingerprint = definitionFingerprint(def, projectRoot);
  const key = def.url ? undefined : def.name + "|" + fingerprint.hash;
  // Apply the current definition before transport selection or a schema-cache
  // hit. Both can bypass spawnStdioUpstream, but must retire the old process.
  retireStdioEntries(def.name, key);
  return def.url ? fingerprint : prepareStdioDefinition(def, projectRoot, fingerprint);
}
function scheduleIdle(entry) {
  if (stdioPool.get(entry.key) !== entry || entry.closed) return;
  clearTimeout(entry.idleTimer);
  entry.idleTimer = setTimeout(() => killPoolEntry(entry.key, entry), IDLE_MS);
  if (entry.idleTimer.unref) entry.idleTimer.unref();
}
// A write is complete only after its callback succeeds while the same upstream
// is still alive. Lifecycle errors also reject writes whose callbacks never run.
function writeJsonRpc(entry, msg) {
  return new Promise((resolve, reject) => {
    if (!isWritableUpstream(entry)) { reject(new Error("upstream stdin is not writable")); return; }
    let settled = false;
    const fail = (error) => {
      if (settled) return;
      settled = true;
      entry.writes.delete(fail);
      reject(error);
    };
    entry.writes.add(fail);
    try {
      entry.proc.stdin.write(JSON.stringify(msg) + "\n", (error) => {
        if (error) { closePoolEntry(entry, error); return; }
        if (settled) return;
        if (!isWritableUpstream(entry)) { fail(new Error("upstream closed during write")); return; }
        settled = true;
        entry.writes.delete(fail);
        resolve();
      });
    } catch (error) { closePoolEntry(entry, error); }
  });
}
function withTimeout(p, ms, label, entry, id) {
  let t;
  const timeout = new Promise((_, rej) => {
    t = setTimeout(() => {
      const e = entry || (p && p._waiterEntry) || null;
      const wid = id != null ? id : (p && p._waiterId != null ? p._waiterId : null);
      if (e && wid != null) {
        try { e.waiters.delete(wid); } catch {}
      }
      rej(new Error("timeout: " + label));
    }, ms);
  });
  return Promise.race([p, timeout]).finally(() => clearTimeout(t));
}
function spawnStdioUpstream(def, projectRoot = resolveProjectRoot()) {
  const { effective, hash } = prepareUpstreamDefinition(def, projectRoot);
  def = effective;
  const key = def.name + "|" + hash;
  retireStdioEntries(def.name, key);
  let entry = stdioPool.get(key);
  if (entry && isWritableUpstream(entry)) return entry;
  if (entry) closePoolEntry(entry, new Error("upstream unavailable"));
  const cmd = def.command;
  if (!cmd) throw new Error("missing command for " + def.name);
  const args = Array.isArray(def.args) ? def.args : [];
  const env = { ...process.env, ...(def.env && typeof def.env === "object" ? def.env : {}) };
  const proc = spawn(cmd, args, { cwd: def.cwd, env, stdio: ["pipe", "pipe", "pipe"] });
  let buffer = "";
  let bufferOverflow = false;
  const waiters = new Map(); // id -> {resolve, reject}
  let nextId = 1;
  entry = { key, name: def.name, fingerprint: hash, proc, waiters, writes: new Set(), nextId: () => nextId++, initialized: false, initPromise: null, closed: false, idleTimer: null, def };
  // Install this immediately: ChildProcess's error handler does not handle
  // errors emitted by its stdin Writable (notably EPIPE).
  proc.stdin.on("error", (error) => {
    closePoolEntry(entry, error);
    try { proc.kill("SIGTERM"); } catch {}
  });
  proc.stdin.on("close", () => closePoolEntry(entry, new Error("upstream stdin closed")));
  proc.on("error", (error) => closePoolEntry(entry, error));
  proc.on("exit", () => closePoolEntry(entry, new Error("upstream exited")));
  proc.on("close", () => closePoolEntry(entry, new Error("upstream closed")));
  proc.stdout.on("data", (chunk) => {
    if (bufferOverflow || entry.closed) return;
    buffer += chunk.toString("utf8");
    if (Buffer.byteLength(buffer, "utf8") > MAX_BUFFER_BYTES || buffer.length > MAX_BUFFER_BYTES) {
      bufferOverflow = true;
      buffer = "";
      closePoolEntry(entry, new Error("upstream output exceeds 2MB limit"));
      try { proc.kill("SIGTERM"); } catch {}
      const killer = setTimeout(() => { try { proc.kill("SIGKILL"); } catch {} }, 100);
      if (killer.unref) killer.unref();
      return;
    }
    let idx;
    while ((idx = buffer.indexOf("\n")) >= 0) {
      const line = buffer.slice(0, idx).trim();
      buffer = buffer.slice(idx + 1);
      if (!line) continue;
      let msg;
      try { msg = JSON.parse(line); } catch { continue; }
      if (msg && msg.id !== undefined && waiters.has(msg.id)) {
        const w = waiters.get(msg.id);
        waiters.delete(msg.id);
        if (msg.error) w.reject(new Error(JSON.stringify(msg.error)));
        else w.resolve(msg.result);
      }
    }
  });
  stdioPool.set(key, entry);
  return entry;
}
function sendToStdio(entry, method, params) {
  const id = entry.nextId();
  let resolveFn;
  let rejectFn;
  const prom = new Promise((resolve, reject) => { resolveFn = resolve; rejectFn = reject; });
  entry.waiters.set(id, { resolve: resolveFn, reject: rejectFn });
  prom._waiterId = id;
  prom._waiterEntry = entry;
  writeJsonRpc(entry, { jsonrpc: "2.0", id, method, params: params || {} }).then(() => {
    scheduleIdle(entry);
  }, (error) => {
    const waiter = entry.waiters.get(id);
    if (waiter) { entry.waiters.delete(id); waiter.reject(error); }
  });
  return prom;
}
async function ensureInitialized(entry) {
  if (!isWritableUpstream(entry)) throw new Error("upstream unavailable");
  if (entry.initialized) return;
  if (!entry.initPromise) {
    entry.initPromise = (async () => {
      try {
        await withTimeout(sendToStdio(entry, "initialize", { protocolVersion: "2024-11-05", capabilities: {}, clientInfo: { name: "t3-mcp-router", version: "1.0.0" } }), 8000, "initialize " + entry.def.name);
        await writeJsonRpc(entry, { jsonrpc: "2.0", method: "notifications/initialized" });
        if (entry.proc.exitCode !== null || entry.closed || !isWritableUpstream(entry)) throw new Error("upstream closed during initialization");
        entry.initialized = true;
      } catch (e) {
        entry.initialized = false;
        entry.initPromise = null;
        throw e;
      }
    })();
  }
  await entry.initPromise;
}
async function stdioToolsList(def, projectRoot = resolveProjectRoot()) {
  const entry = spawnStdioUpstream(def, projectRoot);
  await ensureInitialized(entry);
  const res = await withTimeout(sendToStdio(entry, "tools/list", {}), 10000, "tools/list " + def.name);
  if (!res || !Array.isArray(res.tools)) throw new Error("invalid tools/list from " + def.name);
  return res.tools;
}
async function stdioToolsCall(def, tool, args, projectRoot = resolveProjectRoot()) {
  const entry = spawnStdioUpstream(def, projectRoot);
  await ensureInitialized(entry);
  const res = await withTimeout(sendToStdio(entry, "tools/call", { name: tool, arguments: args || {} }), 15000, "tools/call " + def.name + "/" + tool);
  if (!res || !Array.isArray(res.content)) return { content: [{ type: "text", text: JSON.stringify(res) }] };
  return res;
}
function httpPostJson(urlStr, payload, env) {
  return new Promise((resolve, reject) => {
    let u;
    try { u = new URL(urlStr); } catch (e) { reject(e); return; }
    const body = JSON.stringify(payload);
    const headers = { "Content-Type": "application/json", "Content-Length": Buffer.byteLength(body), Accept: "application/json, text/event-stream" };
    if (env && typeof env === "object") for (const [k, v] of Object.entries(env)) { if (typeof v === "string" && /^[-!#$%&'*+.^_`|~0-9A-Za-z]+$/.test(k)) headers[k] = v; }
    const lib = u.protocol === "https:" ? https : http;
    const req = lib.request({ hostname: u.hostname, port: u.port || (u.protocol === "https:" ? 443 : 80), path: u.pathname + u.search, method: "POST", headers }, (res) => {
      const chunks = [];
      let totalBytes = 0;
      let overflowed = false;
      res.on("data", (c) => {
        if (overflowed) return;
        totalBytes += c.length;
        if (totalBytes > MAX_BUFFER_BYTES) {
          overflowed = true;
          try { res.destroy(); } catch {}
          try { req.destroy(); } catch {}
          reject(new Error("HTTP response exceeds 2MB limit"));
          return;
        }
        chunks.push(c);
      });
      res.on("end", () => {
        if (overflowed) return;
        const text = Buffer.concat(chunks).toString("utf8");
        const ct = String(res.headers["content-type"] || "");
        if (ct.includes("text/event-stream")) {
          let found = null;
          for (const line of text.split(/\r?\n/)) {
            const t = line.trim();
            if (t.startsWith("data:")) {
              const d = t.slice(5).trim();
              if (d && d !== "[DONE]") { try { const j = JSON.parse(d); if (j && (j.result !== undefined || j.error !== undefined)) found = j; } catch {} }
            }
          }
          if (found) { if (found.error) reject(new Error(JSON.stringify(found.error))); else resolve(found.result); return; }
        }
        try {
          const j = JSON.parse(text);
          if (j && j.error) reject(new Error(JSON.stringify(j.error)));
          else resolve(j.result !== undefined ? j.result : j);
        } catch (e) { reject(new Error("invalid HTTP JSON-RPC response: " + text.slice(0, 200))); }
      });
    });
    req.on("error", reject);
    req.write(body);
    req.end();
  });
}
async function upstreamToolsList(def, projectRoot = resolveProjectRoot()) {
  def = prepareUpstreamDefinition(def, projectRoot).effective;
  if (def.url) {
    const res = await withTimeout(httpPostJson(def.url, { jsonrpc: "2.0", id: 1, method: "tools/list", params: {} }, def.env), 10000, "http tools/list " + def.name);
    if (!res || !Array.isArray(res.tools)) throw new Error("invalid tools/list from " + def.name);
    return res.tools;
  }
  return stdioToolsList(def, projectRoot);
}
async function upstreamToolsCall(def, tool, args, projectRoot = resolveProjectRoot()) {
  def = prepareUpstreamDefinition(def, projectRoot).effective;
  if (def.url) {
    const res = await withTimeout(httpPostJson(def.url, { jsonrpc: "2.0", id: 1, method: "tools/call", params: { name: tool, arguments: args || {} } }, def.env), 15000, "http tools/call " + def.name + "/" + tool);
    if (!res || !Array.isArray(res.content)) return { content: [{ type: "text", text: JSON.stringify(res) }] };
    return res;
  }
  return stdioToolsCall(def, tool, args, projectRoot);
}
function readSchemaCache() { const c = readJson(SCHEMA_CACHE_PATH, {}); return c && typeof c === "object" ? c : {}; }
function writeSchemaCache(c) { try { fs.mkdirSync(HUB_DIR, { recursive: true }); const tmp = SCHEMA_CACHE_PATH + ".tmp-" + process.pid; fs.writeFileSync(tmp, JSON.stringify(c, null, 2), "utf8"); fs.renameSync(tmp, SCHEMA_CACHE_PATH); } catch {} }
async function getToolsCachedLive(def, forceLive = false, projectRoot = resolveProjectRoot()) {
  const { effective, hash: fingerprint } = prepareUpstreamDefinition(def, projectRoot);
  def = effective;
  const cache = readSchemaCache();
  if (!forceLive && cache[def.name] && cache[def.name].definitionFingerprint === fingerprint && Array.isArray(cache[def.name].tools)) return cache[def.name].tools;
  const tools = await upstreamToolsList(def, projectRoot);
  cache[def.name] = { definitionFingerprint: fingerprint, tools, fetchedAt: new Date().toISOString() };
  writeSchemaCache(cache);
  return tools;
}

function writeResponse(res, framed) {
  const body = JSON.stringify(res);
  if (framed) {
    process.stdout.write(`Content-Length: ${Buffer.byteLength(body)}\r\n\r\n${body}`);
  } else {
    process.stdout.write(body + "\n");
  }
}
async function handleToolsList() {
  const enabled = agentMemoryEnabled();
  const memoryOnlyTools = memoryTools().filter((tool) => {
    if (tool.name === "memory_status" || tool.name === "plan_update") return true;
    return enabled && isMemoryTool(tool.name);
  });
  if (MEMORY_ONLY_MODE) return { tools: memoryOnlyTools };
  const { servers, projectRoot } = enabledServers();
  const tools = memoryTools().filter((tool) => {
    if (tool.name === "memory_status" || tool.name === "plan_update") return true;
    if (isMemoryTool(tool.name) || tool.name === "context_search") return enabled;
    return true;
  });
  const lazy = servers.filter((s) => s.mode === "project-lazy" || s.mode === "global-lazy");
  const direct = servers.filter((s) => s.mode === "project-direct" || s.mode === "global-direct");
  if (lazy.length) { tools.push(HUB_LIST_DEF, HUB_CALL_DEF); }
  for (const { def } of direct) {
    try {
      const upstream = await getToolsCachedLive(def, false, projectRoot);
      for (const t of upstream) tools.push({ name: `${def.name}__${t.name}`, description: t.description || `${def.name} ${t.name}`, inputSchema: t.inputSchema || { type: "object", properties: {} } });
    } catch {}
  }
  return { tools };
}
async function handleToolsCall(params) {
  const name = params?.name;
  const args = params?.arguments || {};
  if (MEMORY_ONLY_MODE && name !== "memory_status" && name !== "plan_update" && !isMemoryTool(name)) {
    throw new Error("tool unavailable in memory-only mode");
  }
  if (name === "memory_status") {
    const statusPayload = { ...memoryAccessStatus(), ...memoryProjectBindingStatus() };
    const runtimeHints = buildT3RuntimeHintsPayload(process.env);
    if (runtimeHints?.t3RuntimeHints) statusPayload.t3RuntimeHints = runtimeHints.t3RuntimeHints;
    return { content: [{ type: "text", text: JSON.stringify(statusPayload) }] };
  }
  if ((isMemoryTool(name) || name === "context_search") && !agentMemoryEnabled()) {
    throw new Error("Agent memory access is disabled or unavailable");
  }
  if (name === "memory_search") {
    if (!getMemoryVault()) throw new Error("memory-vault not available");
    const projectRoot = resolveMemoryProjectRoot(args.projectRoot);
    const scopes = memoryScopeOptions(args);
    const res = compactMemorySearchResult(await vaultSearch({ projectRoot, query: args.query, module: args.module, includeGlobal: false, limit: boundedMemoryLimit(args.limit), ...scopes }));
    if (res && Array.isArray(res.content)) return res;
    return { content: [{ type: "text", text: JSON.stringify(res ?? null) }] };
  }
  if (name === "memory_read") {
    const projectRoot = resolveMemoryProjectRoot(args.projectRoot);
    if (typeof args.id !== "string" || !args.id.trim()) throw new Error("memory id required");
    if (!getMemoryVault()) throw new Error("memory-vault not available");
    const scopes = memoryScopeOptions(args);
    const res = await vaultRead({ projectRoot, module: args.module, id: args.id.trim(), includeGlobal: false, ...scopes });
    if (res && Array.isArray(res.content)) return res;
    return { content: [{ type: "text", text: JSON.stringify(res ?? null) }] };
  }
  if (name === "memory_write") {
    if (!getMemoryVault()) throw new Error("memory-vault not available");
    const projectRoot = resolveMemoryProjectRoot(args.projectRoot);
    const scopes = memoryScopeOptions(args);
    // Pin Shield (Runelay security model): pinned memories get permanent
    // high-priority injection into every agent. Only a human in the Hub UI
    // may set them. Agent-supplied pinned:true from web/issue injection is
    // always stripped to false so an attacker cannot plant an immortal memory.
    const reservedTags = Array.isArray(args.tags) && args.tags.some((tag) => ["pinned", "core"].includes(String(tag).trim().toLowerCase()));
    if (reservedTags) {
      return { content: [{ type: "text", text: JSON.stringify({ ok: false, error: "pinned/core tags are human-only" }) }] };
    }
    const res = await vaultWrite({ projectRoot, module: args.module, title: args.title, content: args.content, kind: args.kind, tags: args.tags, agent: args.agent, supersedesId: args.supersedesId, autoEvolve: args.autoEvolve, pinned: false, rejectProtectedSupersedes: true, scope: agentWriteScope(args, scopes) });
    if (res && Array.isArray(res.content)) return res;
    return { content: [{ type: "text", text: JSON.stringify(res ?? true) }] };
  }
  if (name === "context_search") {
    if (typeof args.query !== "string" || !args.query.trim()) throw new Error("query required");
    const query = args.query.trim();
    const limit = boundedMemoryLimit(args.limit);
    const projectRoot = resolveMemoryProjectRoot(args.projectRoot);
    const scopes = memoryScopeOptions(args);
    const startedAt = Date.now();
    let memories = [];
    if (getMemoryVault()) {
      try {
        const res = await vaultSearch({ projectRoot, query, module: args.module, includeGlobal: false, limit, ...scopes });
        if (res && Array.isArray(res.items)) memories = res.items;
        else if (res && Array.isArray(res.content)) {
          try {
            const first = res.content.find((c) => c && typeof c.text === "string");
            const parsed = first ? JSON.parse(first.text) : null;
            if (parsed && Array.isArray(parsed.items)) memories = parsed.items;
          } catch {}
        } else if (Array.isArray(res)) memories = res;
      } catch { memories = []; }
    }
    const memoriesOut = memories.slice(0, limit).map((m) => {
      const text = String((m && (m.content || m.snippet || m.text)) || "");
      return {
        id: m && (m.id || m.memoryId) ? String(m.id || m.memoryId) : "",
        title: String((m && (m.title || m.heading)) || ""),
        module: String((m && m.module) || ""),
        snippet: text.slice(0, 240),
        ...(text.length > 240 ? { snippetTruncated: true } : {}),
        score: typeof (m && m.score) === "number" ? m.score : undefined,
      };
    });
    const ql = query.toLowerCase();
    const skills = discoverSkills(projectRoot).filter((s) => {
      const hay = (s.id + " " + s.name + " " + s.description + " " + s.dir + " " + s.path).toLowerCase();
      return hay.includes(ql);
    }).slice(0, limit).map((s) => ({ slug: s.id, id: s.id, name: s.name, description: s.description, path: s.path }));
    const payload = { query, memories: memoriesOut, skills, tookMs: Date.now() - startedAt };
    return { content: [{ type: "text", text: JSON.stringify(payload) }] };
  }
  if (name === "skill_read") {
    const projectRoot = args.projectRoot || resolveProjectRoot();
    const skill = findSkill(args.slug, projectRoot);
    const { content, truncated, size } = readSkillFileLimited(skill.dir, skill.path, SKILL_READ_MAX_BYTES);
    return { content: [{ type: "text", text: JSON.stringify({ slug: skill.id, name: skill.name, description: skill.description, path: skill.path, content, truncated, size }) }] };
  }
  if (name === "skill_read_file") {
    const projectRoot = args.projectRoot || resolveProjectRoot();
    const skill = findSkill(args.slug, projectRoot);
    const relativePath = args.relativePath;
    if (typeof relativePath !== "string" || !relativePath) throw new Error("relativePath required");
    if (path.isAbsolute(relativePath)) throw new Error("invalid relativePath (must be relative): " + relativePath);
    const target = path.resolve(skill.dir, relativePath);
    const rel = path.relative(skill.dir, target);
    if (!rel || rel.startsWith("..") || path.isAbsolute(rel)) throw new Error("path traversal blocked: " + relativePath);
    try {
      const realTarget = fs.realpathSync(target);
      const realSkill = fs.realpathSync(skill.dir);
      const realRel = path.relative(realSkill, realTarget);
      if (realRel.startsWith("..") || path.isAbsolute(realRel)) throw new Error("path traversal blocked: " + relativePath);
    } catch (e) {
      if (e && String(e.message).includes("traversal")) throw e;
    }
    const { content, truncated, size } = readSkillFileLimited(skill.dir, target, SKILL_READ_MAX_BYTES);
    return { content: [{ type: "text", text: JSON.stringify({ slug: skill.id, relativePath, path: target, content, truncated, size }) }] };
  }
  if (name === "memory_consolidate") {
    if (!getMemoryVault()) throw new Error("memory-vault not available");
    const projectRoot = resolveMemoryProjectRoot(args.projectRoot);
    memoryScopeOptions(args);
    const res = await vaultConsolidate({ projectRoot, projectSlug: args.projectSlug, dryRun: args.dryRun, excludeProtected: true });
    return { content: [{ type: "text", text: JSON.stringify(res ?? null) }] };
  }
  if (name === "memory_rollback") {
    if (!getMemoryVault()) throw new Error("memory-vault not available");
    const projectRoot = resolveMemoryProjectRoot(args.projectRoot);
    memoryScopeOptions(args);
    const res = await vaultRollback({ projectRoot, projectSlug: args.projectSlug, id: args.id, targetVersion: args.targetVersion, revisionId: args.revisionId, rejectProtectedRollback: true });
    return { content: [{ type: "text", text: JSON.stringify(res ?? null) }] };
  }
  if (name === "plan_update") {
    const board = getTaskBoard();
    if (!board || !planUpdateRouter) throw new Error("Hub plan update is unavailable");
    const res = planUpdateRouter.handlePlanUpdate(args, board, resolveProjectRoot);
    return { content: [{ type: "text", text: JSON.stringify(res ?? null) }] };
  }
  if (name === "subagent_resolve") {
    if (!hubSubagentsMod || typeof hubSubagentsMod.resolveSubagentRoute !== "function") throw new Error("hub-subagents not available");
    const projectRoot = args.projectRoot || resolveProjectRoot();
    const res = hubSubagentsMod.resolveSubagentRoute({ idOrTitle: args.idOrTitle, role: args.role, projectRoot });
    return { content: [{ type: "text", text: JSON.stringify(res ?? null) }] };
  }
  if (name === "hub_list_mcp_tools") {
    const { servers, projectRoot } = enabledServers();
    const lazy = servers.filter((s) => s.mode === "project-lazy" || s.mode === "global-lazy");
    const target = args.server ? lazy.find((s) => s.def.name === args.server) : null;
    if (args.server && !target) throw new Error("server not enabled as lazy: " + args.server);
    const list = target ? [target] : lazy;
    const serversObj = {};
    for (const { def } of list) {
      try {
        const tools = await getToolsCachedLive(def, true, projectRoot);
        serversObj[def.name] = { tools: tools.map((t) => ({ name: t.name, description: t.description || "", inputSchema: t.inputSchema || { type: "object", properties: {} } })) };
      } catch (e) { serversObj[def.name] = { tools: [], error: String(e && e.message || e) }; }
    }
    const detail = target ? serversObj[target.def.name] : null;
    const payload = target ? { server: target.def.name, tools: detail?.tools || [], ...(detail?.error ? { error: detail.error } : {}) } : { servers: serversObj };
    return { content: [{ type: "text", text: JSON.stringify(payload) }] };
  }
  if (name === "hub_call_mcp_tool") {
    const { servers, projectRoot } = enabledServers();
    const lazy = servers.filter((s) => s.mode === "project-lazy" || s.mode === "global-lazy");
    const entry = lazy.find((s) => s.def.name === args.server);
    if (!entry) throw new Error("server not enabled as lazy: " + (args.server || ""));
    if (!args.tool) throw new Error("tool required");
    return upstreamToolsCall(entry.def, args.tool, args.arguments || {}, projectRoot);
  }
  if (name && name.includes("__")) {
    const idx = name.indexOf("__");
    const srv = name.slice(0, idx), tool = name.slice(idx + 2);
    const { servers, projectRoot } = enabledServers();
    const direct = servers.filter((s) => s.mode === "project-direct" || s.mode === "global-direct");
    const entry = direct.find((s) => s.def.name === srv);
    if (!entry) throw new Error("server not enabled as direct: " + srv);
    return upstreamToolsCall(entry.def, tool, args, projectRoot);
  }
  throw new Error("unknown tool: " + name);
}
async function handleMessage(msg, framed) {
  const isNotification = msg.id === undefined || msg.id === null;
  if (String(msg.method || "").startsWith("notifications/")) return;
  const reply = (result) => { if (!isNotification) writeResponse({ jsonrpc: "2.0", id: msg.id, result }, framed); };
  const fail = (code, message) => { if (!isNotification) writeResponse({ jsonrpc: "2.0", id: msg.id, error: { code, message } }, framed); };
  try {
    if (msg.method === "initialize") {
      const ver = msg.params?.protocolVersion || "2024-11-05";
      const initResult = { protocolVersion: ver, capabilities: { tools: {} }, serverInfo: { name: "t3-mcp-router", version: "1.0.0" } };
      const runtimeHints = buildT3RuntimeHintsPayload(process.env);
      if (runtimeHints?.instructions) initResult.instructions = runtimeHints.instructions;
      reply(initResult);
    } else if (msg.method === "ping") { reply({}); }
    else if (msg.method === "tools/list") { reply(await handleToolsList()); }
    else if (msg.method === "tools/call") { reply(await handleToolsCall(msg.params || {})); }
    else if (isNotification) return;
    else fail(-32601, "method not found: " + msg.method);
  } catch (e) { fail(-32603, String((e && e.message) || e)); }
}
let inBuffer = "";
function onStdinData(chunk) {
  inBuffer += chunk.toString("utf8");
  if (inBuffer.length > MAX_BUFFER_BYTES || Buffer.byteLength(inBuffer, "utf8") > MAX_BUFFER_BYTES) {
    inBuffer = "";
    return;
  }
  while (true) {
    const trimmedStart = inBuffer.replace(/^\s+/, "");
    const isFramed = /^content-length:/i.test(trimmedStart);
    if (isFramed) {
      const headerEnd = trimmedStart.search(/\r?\n\r?\n/);
      if (headerEnd === -1) { inBuffer = trimmedStart; break; }
      const headerBlock = trimmedStart.slice(0, headerEnd);
      const after = trimmedStart.slice(headerEnd).replace(/^\r?\n\r?\n/, "");
      const m = headerBlock.match(/content-length:\s*(\d+)/i);
      if (!m) { inBuffer = after; continue; }
      const len = parseInt(m[1], 10);
      if (after.length < len) { inBuffer = trimmedStart; break; }
      const body = after.slice(0, len);
      inBuffer = after.slice(len);
      let msg;
      try { msg = JSON.parse(body); } catch { continue; }
      handleMessage(msg, true).catch(() => {});
    } else {
      const nl = inBuffer.indexOf("\n");
      if (nl === -1) break;
      const line = inBuffer.slice(0, nl).trim();
      inBuffer = inBuffer.slice(nl + 1);
      if (!line) continue;
      let msg;
      try { msg = JSON.parse(line); } catch { continue; }
      handleMessage(msg, false).catch(() => {});
    }
  }
}
if (require.main === module) {
  process.stdin.on("data", onStdinData);
  process.stdin.on("end", () => { for (const k of [...stdioPool.keys()]) killPoolEntry(k); });
}
if (require.main !== module) {
  module.exports = { handleToolsCall, handleToolsList, handleMessage, memoryTools, withTimeout, spawnStdioUpstream, killPoolEntry, sendToStdio, stdioPool, discoverSkills, findSkill, isT3CodeRuntime, isTrustedT3ProviderPath, metadataPointsUnderT3Providers, readT3RuntimeHints, readT3RuntimeHintsFallback, buildT3RuntimeHintsPayload, MAX_BUFFER_BYTES, SKILL_READ_MAX_BYTES };
}


