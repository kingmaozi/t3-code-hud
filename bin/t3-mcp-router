#!/usr/bin/env node
"use strict";
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawn } = require("node:child_process");
const http = require("node:http");
const https = require("node:https");
const crypto = require("node:crypto");
const HOME_DIR = process.env.HOME || os.homedir();
const HUB_DIR = process.env.T3_HUB_DIR || path.join(HOME_DIR, ".t3", "hub");
const STATE_PATH = path.join(HUB_DIR, "state.json");
const REGISTRY_PATH = path.join(HUB_DIR, "mcp-registry.json");
const SCHEMA_CACHE_PATH = path.join(HUB_DIR, "mcp-schema-cache.json");
const IDLE_MS = 3 * 60 * 1000;
const MAX_BUFFER_BYTES = 2 * 1024 * 1024;
const SKILL_READ_MAX_BYTES = 64 * 1024;
const T3_RUNTIME_HINTS_FILE = "t3-runtime-hints.json";
const T3_RUNTIME_HINTS_SCOPE = "t3-code-only";
const T3_RUNTIME_HINTS_MAX_LENGTH = 2000;
const T3_RUNTIME_HINTS_MAX_BYTES = 32 * 1024;
const T3_TRUNCATED_TOOLS = Object.freeze([
  "delegate_task",
  "html_render",
  "t3_thread_launch",
  "schedule_task",
  "t3_project_update",
]);
const DEFAULT_T3_RUNTIME_HINTS_FALLBACK = Object.freeze({
  version: 1,
  enabled: true,
  scope: T3_RUNTIME_HINTS_SCOPE,
  planUpdateHint: "仅 T3 Code 顶层主会话执行 >=3 步复杂多步任务时，开干前及关键阶段变化时顺手调一次 plan_update(title, steps:[{text,status}])（status 用 pending|in_progress|completed）点亮顶栏蓝环进度；简单问答、<=2 步小活及所有子代理不调。",
  acp48kFallbackHint: "若 antigravity-acp 因 48KiB 上限截断 t3-code 原生工具（delegate_task / html_render / t3_thread_launch / schedule_task / t3_project_update），必须以单条直连命令直接执行 ELECTRON_RUN_AS_NODE=1 \"$T3_ACP_MCP_NODE\" ${T3_ACP_MCP_ENTRYPOINT:+\"$T3_ACP_MCP_ENTRYPOINT\"} acp-mcp-call <tool> '<json>'（严禁外包 node -e / python3 / 脚本套壳或尾部串联其他命令，否则 T3 正则失配、html_render 不会内嵌卡片；按需读 <appDataDir>/mcp/t3-code/<tool>.json 核对参数）。",
});
let memoryAccessMod = null;
let memoryAccess = null;
for (const cand of [
  process.env.T3_HUB_MEMORY_ACCESS ? path.resolve(process.env.T3_HUB_MEMORY_ACCESS) : null,
  path.join(__dirname, "..", "src", "hub-memory-access.cjs"),
  path.join(__dirname, "..", "hud-plugin", "hub-memory-access.cjs"),
  path.join(HOME_DIR, ".t3", "hud-plugin", "hub-memory-access.cjs"),
].filter(Boolean)) {
  try {
    memoryAccessMod = require(cand);
    memoryAccess = memoryAccessMod.createMemoryAccessManager({ homeDir: HOME_DIR, hubDir: HUB_DIR, userDataDir: process.env.T3CODE_HOME || path.join(HOME_DIR, ".t3", "userdata") });
    break;
  } catch {}
}
const MEMORY_ONLY_MODE = process.argv.includes("--memory-only");

const METADATA_TRUSTED_TOP_LEVEL_KEYS = Object.freeze([
  "path", "sourcePath", "sourceDir", "configDir", "configPath", "providerDir",
  "profileDir", "homeDir", "dataDir", "userDataDir", "appDataDir", "metadataPath",
]);
const STRICT_UTF8_DECODER = new TextDecoder("utf-8", { fatal: true, ignoreBOM: true });
function isLoopbackEndpoint(raw) {
  if (typeof raw !== "string" || /[\r\n\t\0]/.test(raw)) return false;
  const trimmed = raw.trim();
  if (!trimmed) return false;
  try {
    const parsed = new URL(trimmed);
    const host = parsed.hostname.toLowerCase();
    return (parsed.protocol === "http:" || parsed.protocol === "https:") &&
      ["127.0.0.1", "localhost", "[::1]", "::1"].includes(host) &&
      !parsed.username && !parsed.password;
  } catch {
    return false;
  }
}
function resolveProvidersRoot(env = process.env) {
  const rawHome = typeof env?.HOME === "string" ? env.HOME.trim() : "";
  const envHome = rawHome && !/[\r\n\t\0]/.test(rawHome) && path.isAbsolute(rawHome)
    ? path.resolve(rawHome)
    : path.resolve(HOME_DIR);
  return path.resolve(path.join(envHome, ".t3", "userdata", "providers"));
}
function realpathOrNull(target) {
  try { return fs.realpathSync(target); } catch { return null; }
}
function isStrictlyInside(base, candidate) {
  const rel = path.relative(base, candidate);
  return Boolean(rel) && rel !== "." && rel !== ".." && !rel.startsWith(".." + path.sep) && !path.isAbsolute(rel);
}
function isTrustedT3ProviderPath(raw, providersRoot = resolveProvidersRoot(process.env), { expectDirectory = false } = {}) {
  if (typeof raw !== "string" || /[\r\n\t\0]/.test(raw)) return false;
  const trimmed = raw.trim();
  if (!trimmed || !path.isAbsolute(trimmed)) return false;
  if (trimmed.split(/[\\/]+/).includes("..")) return false;
  let origSt;
  try { origSt = fs.statSync(trimmed); } catch { return false; }
  if (expectDirectory ? !origSt.isDirectory() : !origSt.isDirectory() && !origSt.isFile()) return false;
  const resolvedBase = path.resolve(providersRoot);
  const resolvedCand = path.resolve(trimmed);
  if (!isStrictlyInside(resolvedBase, resolvedCand) || /\s/.test(path.relative(resolvedBase, resolvedCand))) return false;
  const realBase = realpathOrNull(resolvedBase);
  const realCand = realpathOrNull(trimmed);
  if (!realBase || !realCand || !isStrictlyInside(realBase, realCand)) return false;
  let st;
  try { st = fs.statSync(realCand); } catch { return false; }
  return expectDirectory ? st.isDirectory() : st.isDirectory() || st.isFile();
}
function metadataPointsUnderT3Providers(raw, providersRoot) {
  if (typeof raw !== "string") return false;
  const trimmed = raw.trim();
  if (!trimmed) return false;
  if (!trimmed.startsWith("{")) return isTrustedT3ProviderPath(raw, providersRoot);
  let parsed;
  try { parsed = JSON.parse(trimmed); } catch { return false; }
  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return false;
  return METADATA_TRUSTED_TOP_LEVEL_KEYS.some((key) =>
    Object.hasOwn(parsed, key) && typeof parsed[key] === "string" && isTrustedT3ProviderPath(parsed[key], providersRoot));
}
function isT3CodeRuntime(env = process.env) {
  if (!env || typeof env !== "object") return false;
  if (typeof env.T3_ACP_MCP_NODE === "string" && env.T3_ACP_MCP_NODE.trim() !== "" && !/[\r\n\0]/.test(env.T3_ACP_MCP_NODE)) return true;
  if (isLoopbackEndpoint(env.T3_ACP_MCP_ENDPOINT)) return true;
  for (const key of ["T3CODE_THREAD_ID", "T3_THREAD_ID"]) {
    if (typeof env[key] === "string" && env[key].trim() !== "" && !/[\s\0]/.test(env[key].trim())) return true;
  }
  if (typeof env.T3_CODE_ENV === "string" && ["1", "true"].includes(env.T3_CODE_ENV.trim().toLowerCase())) return true;
  const providersRoot = resolveProvidersRoot(env);
  if (isTrustedT3ProviderPath(env.CODEX_HOME, providersRoot, { expectDirectory: true })) return true;
  if (metadataPointsUnderT3Providers(env.ANTIGRAVITY_SOURCE_METADATA, providersRoot)) return true;
  return false;
}
function isTrustedMacAliasBin(target) {
  const expected = target === "/tmp" ? "/private/tmp" : target === "/var" ? "/private/var" : null;
  if (!expected) return false;
  try { return fs.realpathSync(target) === expected; } catch { return false; }
}
function isDirectoryEntryBin(target, stat) {
  if (stat.isDirectory()) return true;
  if (!stat.isSymbolicLink() || !isTrustedMacAliasBin(target)) return false;
  try { return fs.statSync(target).isDirectory(); } catch { return false; }
}
function assertNoSymlinkPathBin(target, { allowMissing = true, includeTarget = true } = {}) {
  const absolute = path.resolve(target);
  const parsed = path.parse(absolute);
  let current = parsed.root;
  const parts = absolute.slice(parsed.root.length).split(path.sep).filter(Boolean);
  const limit = includeTarget ? parts.length : Math.max(0, parts.length - 1);
  for (let i = 0; i < limit; i += 1) {
    current = path.join(current, parts[i]);
    let st;
    try { st = fs.lstatSync(current); }
    catch (error) {
      if (error?.code === "ENOENT" && allowMissing) break;
      throw error;
    }
    if (st.isSymbolicLink() && !isTrustedMacAliasBin(current)) throw new Error("unsafe_symlink");
    if (i < limit - 1 && !isDirectoryEntryBin(current, st)) throw new Error("unsafe_path");
  }
  return absolute;
}
function readT3RuntimeHintsFallback(hintsPath = path.join(HUB_DIR, T3_RUNTIME_HINTS_FILE)) {
  const defaults = memoryAccessMod?.DEFAULT_T3_RUNTIME_HINTS || DEFAULT_T3_RUNTIME_HINTS_FALLBACK;
  const untrusted = (warning) => ({
    trusted: false,
    enabled: false,
    planUpdateHint: "",
    acp48kFallbackHint: "",
    corrupted: true,
    fallback: true,
    warning,
  });
  let fd = null;
  try {
    assertNoSymlinkPathBin(hintsPath, { allowMissing: true, includeTarget: true });
    let st;
    try { st = fs.lstatSync(hintsPath); }
    catch (error) {
      if (error?.code === "ENOENT") {
        return { ...defaults, trusted: true, enabled: true, corrupted: false, fallback: false };
      }
      return untrusted("runtime_hints_unreadable");
    }
    if (st.isSymbolicLink() || !st.isFile() || st.size > T3_RUNTIME_HINTS_MAX_BYTES) return untrusted("unsafe_file");
    fd = fs.openSync(hintsPath, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW || 0));
    const opened = fs.fstatSync(fd);
    if (!opened.isFile() || opened.dev !== st.dev || opened.ino !== st.ino) return untrusted("file_changed");
    if ((opened.mode & 0o777 & 0o022) !== 0) return untrusted("unsafe_permissions");
    if (opened.size > T3_RUNTIME_HINTS_MAX_BYTES) return untrusted("unsafe_file");
    const buf = fs.readFileSync(fd);
    if (buf.length > T3_RUNTIME_HINTS_MAX_BYTES) return untrusted("unsafe_file");
    let text;
    try { text = STRICT_UTF8_DECODER.decode(buf); } catch { return untrusted("invalid_utf8"); }
    let doc;
    try { doc = JSON.parse(text); } catch { return untrusted("invalid_json"); }
    if (!doc || typeof doc !== "object" || Array.isArray(doc)) return untrusted("invalid_schema");
    if (doc.version !== 1 || typeof doc.enabled !== "boolean") return untrusted("invalid_schema");
    if (doc.scope !== undefined && doc.scope !== T3_RUNTIME_HINTS_SCOPE) return untrusted("invalid_schema");
    if (typeof doc.planUpdateHint !== "string" || doc.planUpdateHint.includes("\0") || doc.planUpdateHint.length > T3_RUNTIME_HINTS_MAX_LENGTH) {
      return untrusted("invalid_schema");
    }
    if (typeof doc.acp48kFallbackHint !== "string" || doc.acp48kFallbackHint.includes("\0") || doc.acp48kFallbackHint.length > T3_RUNTIME_HINTS_MAX_LENGTH) {
      return untrusted("invalid_schema");
    }
    return {
      ...defaults,
      trusted: true,
      enabled: doc.enabled,
      planUpdateHint: doc.planUpdateHint,
      acp48kFallbackHint: doc.acp48kFallbackHint,
      corrupted: false,
      fallback: false,
    };
  } catch (error) {
    return untrusted(error?.message === "unsafe_symlink" ? "unsafe_symlink" : "runtime_hints_untrusted");
  } finally {
    try { if (fd !== null) fs.closeSync(fd); } catch {}
  }
}
function readT3RuntimeHints() {
  if (memoryAccess && typeof memoryAccess.getT3RuntimeHints === "function") {
    try {
      const res = memoryAccess.getT3RuntimeHints();
      if (res && typeof res === "object") return res;
    } catch {}
    return {
      trusted: false,
      enabled: false,
      planUpdateHint: "",
      acp48kFallbackHint: "",
      corrupted: true,
      fallback: true,
      warning: "runtime_hints_untrusted",
    };
  }
  return readT3RuntimeHintsFallback();
}
function buildT3RuntimeHintsPayload(env = process.env) {
  if (!isT3CodeRuntime(env)) return null;
  const hints = readT3RuntimeHints();
  if (!hints || hints.trusted !== true || hints.enabled !== true || hints.corrupted === true || hints.fallback === true) return null;
  const planUpdate = typeof hints.planUpdateHint === "string" ? hints.planUpdateHint.trim() : "";
  const acp48kFallback = typeof hints.acp48kFallbackHint === "string" ? hints.acp48kFallbackHint.trim() : "";
  if (!planUpdate && !acp48kFallback) return null;
  const sections = [];
  if (planUpdate) sections.push("[T3 Code plan_update] " + planUpdate);
  if (acp48kFallback) sections.push("[T3 Code 48KiB fallback] " + acp48kFallback);
  const t3RuntimeHints = { scope: T3_RUNTIME_HINTS_SCOPE };
  if (planUpdate) t3RuntimeHints.planUpdate = planUpdate;
  if (acp48kFallback) {
    t3RuntimeHints.acp48kFallback = acp48kFallback;
    t3RuntimeHints.truncatedTools = [...(memoryAccessMod?.RUNTIME_HINTS_TRUNCATED_TOOLS || T3_TRUNCATED_TOOLS)];
  }
  return { instructions: sections.join("\n"), t3RuntimeHints };
}

function memoryAccessStatus() {
  try { return memoryAccess ? memoryAccess.readMemoryOnlyStatus() : { ok: false, enabled: false, state: "unknown", serverVersion: "1", vaultAvailable: false }; }
  catch { return { ok: false, enabled: false, state: "unknown", serverVersion: "1", vaultAvailable: false }; }
}
function agentMemoryEnabled() { return memoryAccessStatus().state === "enabled"; }
function isMemoryTool(name) { return typeof name === "string" && name.startsWith("memory_") && name !== "memory_status"; }

let memoryVault = null;
let memoryVaultLoaded = false;
function getMemoryVault() {
  if (memoryVaultLoaded) return memoryVault;
  memoryVaultLoaded = true;
  for (const cand of [
    process.env.T3_MEMORY_VAULT ? path.resolve(process.env.T3_MEMORY_VAULT) : null,
    path.join(__dirname, "..", "src", "memory-vault.cjs"),
    path.join(__dirname, "..", "hud-plugin", "memory-vault.cjs"),
    path.join(HOME_DIR, ".t3", "hud-plugin", "memory-vault.cjs"),
  ].filter(Boolean)) {
    try { memoryVault = require(cand); if (memoryVault) break; } catch {}
  }
  return memoryVault;
}

function readJson(p, fb) { try { return JSON.parse(fs.readFileSync(p, "utf8")); } catch { return fb; } }
function readState() { const s = readJson(STATE_PATH, {}); return s && typeof s === "object" ? s : {}; }
function readRegistry() {
  const r = readJson(REGISTRY_PATH, []);
  if (Array.isArray(r)) return r;
  if (r && typeof r === "object" && Array.isArray(r.servers)) return r.servers;
  if (r && typeof r === "object" && r.mcpServers && typeof r.mcpServers === "object") return Object.entries(r.mcpServers).map(([name, v]) => ({ name, ...(v || {}) }));
  if (r && typeof r === "object") return Object.entries(r).map(([name, v]) => ({ name, ...(v || {}) }));
  return [];
}
function dirExistsBin(p) { try { return fs.statSync(p).isDirectory(); } catch { return false; } }
function listDirsBin(dir) {
  try { return fs.readdirSync(dir, { withFileTypes: true }).filter((e) => e.isDirectory() || e.isSymbolicLink()).map((e) => path.join(dir, e.name)); } catch { return []; }
}
function skillFileExists(p) { try { return fs.statSync(p).isFile(); } catch { return false; } }
function canonicalProjectRoot(root) {
  if (typeof root !== "string" || !root || !path.isAbsolute(root)) return null;
  const absolute = path.resolve(root);
  try { return fs.realpathSync(absolute); } catch { return absolute; }
}
function hasSymlinkComponent(root) {
  if (typeof root !== "string" || !path.isAbsolute(root)) return true;
  const absolute = path.resolve(root), parsed = path.parse(absolute);
  let current = parsed.root;
  for (const part of absolute.slice(parsed.root.length).split(path.sep).filter(Boolean)) {
    current = path.join(current, part);
    try { if (fs.lstatSync(current).isSymbolicLink()) return true; }
    catch (error) { if (error?.code !== "ENOENT") return true; break; }
  }
  return false;
}
let memoryProjectContextResolver = null;
function loadMemoryProjectContextResolver() {
  if (memoryProjectContextResolver) return memoryProjectContextResolver;
  for (const cand of [
    process.env.T3_HUB_MEMORY_PROJECT_CONTEXT ? path.resolve(process.env.T3_HUB_MEMORY_PROJECT_CONTEXT) : null,
    path.join(__dirname, "..", "src", "hub-memory-project-context.cjs"),
    path.join(__dirname, "..", "hud-plugin", "hub-memory-project-context.cjs"),
    path.join(HOME_DIR, ".t3", "hud-plugin", "hub-memory-project-context.cjs"),
  ].filter(Boolean)) {
    try {
      const mod = require(cand);
      if (typeof mod.resolveMemoryProjectContext === "function") { memoryProjectContextResolver = mod.resolveMemoryProjectContext; break; }
    } catch {}
  }
  return memoryProjectContextResolver;
}
let boundMemoryProjectContext = null;
function currentMemoryProjectContext() {
  if (boundMemoryProjectContext) return boundMemoryProjectContext;
  const resolver = loadMemoryProjectContextResolver();
  if (!resolver) return { projectBound: false, projectRoot: null, source: null, reason: "resolver_unavailable" };
  let resolved;
  try {
    resolved = resolver({ cwd: process.cwd(), homeDir: HOME_DIR, ...(process.env.T3CODE_HOME ? { t3Home: process.env.T3CODE_HOME } : {}) });
  } catch {
    resolved = { projectBound: false, projectRoot: null, source: null, reason: "resolver_error" };
  }
  if (resolved?.projectBound === true && typeof resolved.projectRoot === "string" && path.isAbsolute(resolved.projectRoot)) {
    boundMemoryProjectContext = Object.freeze({
      projectBound: true,
      projectRoot: canonicalProjectRoot(resolved.projectRoot),
      source: resolved.source || null,
      reason: resolved.reason || "matched",
    });
    return boundMemoryProjectContext;
  }
  return {
    projectBound: false,
    projectRoot: null,
    source: resolved?.source || null,
    reason: typeof resolved?.reason === "string" ? resolved.reason : "context_required",
  };
}
function memoryProjectBindingStatus() {
  const current = currentMemoryProjectContext();
  return {
    projectBound: current.projectBound === true,
    projectRoot: current.projectBound ? current.projectRoot : null,
    projectBindingSource: current.source || null,
    projectBindingReason: current.reason || "context_required",
  };
}
function resolveMemoryProjectRoot(requestedRoot) {
  const current = currentMemoryProjectContext();
  if (!current.projectBound) throw new Error(`project context required: ${current.reason || "context_required"}`);
  if (requestedRoot == null || requestedRoot === "") throw new Error("projectRoot required: call memory_status, confirm the current T3 project, then pass its projectRoot");
  if (typeof requestedRoot !== "string" || !path.isAbsolute(requestedRoot)) throw new Error("projectRoot must be an absolute path matching the bound T3 project");
  const selected = canonicalProjectRoot(requestedRoot);
  let isDirectory = false;
  try { isDirectory = fs.statSync(selected).isDirectory(); } catch {}
  if (!isDirectory || selected !== current.projectRoot) throw new Error("projectRoot does not match the bound T3 project");
  return current.projectRoot;
}
function memoryScopeOptions(args = {}) {
  const scope = args.scope == null || args.scope === "" ? undefined : String(args.scope).toLowerCase();
  const scopeFilter = args.scopeFilter == null || args.scopeFilter === "" ? undefined : String(args.scopeFilter).toLowerCase();
  if (scope && !["shared", "worktree"].includes(scope)) throw new Error("global or invalid memory scope is unavailable");
  if (scopeFilter && !["auto", "shared", "worktree", "all"].includes(scopeFilter)) throw new Error("global or invalid memory scopeFilter is unavailable");
  if (String(args.projectSlug || "").toLowerCase() === "_global") throw new Error("global memory is unavailable");
  return { ...(scope ? { scope } : {}), ...(scopeFilter ? { scopeFilter } : {}) };
}
function agentWriteScope(args = {}, scopes = {}) {
  if (scopes.scope) return scopes.scope;
  const kind = String(args.kind || "").trim().toLowerCase();
  const tags = Array.isArray(args.tags) ? args.tags.map((tag) => String(tag).trim().toLowerCase()) : [];
  return ["progress", "wip", "scratch"].includes(kind) || tags.includes("wip") || tags.includes("worktree") ? "worktree" : "shared";
}
function boundedMemoryLimit(value) {
  const parsed = Number(value);
  return Math.min(20, Math.max(1, Number.isFinite(parsed) && parsed > 0 ? Math.floor(parsed) : 6));
}
function projectModeKeys(projects, root) {
  const canonical = canonicalProjectRoot(root);
  if (!canonical) return [];
  const aliases = Object.keys(projects || {}).filter((key) => !hasSymlinkComponent(key) && canonicalProjectRoot(key) === canonical).sort();
  return [...new Set([canonical, ...aliases])];
}
function modeFor(modes, name) {
  if (!modes || typeof modes !== "object") return undefined;
  if (Object.prototype.hasOwnProperty.call(modes, name)) return modes[name];
  const matches = Object.keys(modes).filter((key) => normModeKey(key) === normModeKey(name));
  return matches.length === 1 ? modes[matches[0]] : undefined;
}
function normModeKey(name) { return String(name).toLowerCase().replace(/_/g, "-"); }
function projectModeFor(projects, root, name) {
  for (const key of projectModeKeys(projects, root)) {
    const mode = modeFor(projects?.[key], name);
    if (mode !== undefined) return mode;
  }
  return undefined;
}
function parseSkillMeta(skillFile) {
  let raw = "";
  try { raw = fs.readFileSync(skillFile, "utf8"); } catch { return { name: "", description: "" }; }
  let name = "", description = "";
  const fm = raw.match(/^---\r?\n([\s\S]*?)\r?\n---/);
  if (fm) {
    const block = fm[1];
    const nd = block.match(/^name:\s*(.+)$/m);
    const dd = block.match(/^description:\s*(.+)$/m);
    if (nd) name = nd[1].trim().replace(/^["']|["']$/g, "");
    if (dd) description = dd[1].trim().replace(/^["']|["']$/g, "");
  }
  if (!description) {
    const body = fm ? raw.slice(fm[0].length) : raw;
    for (const line of body.split("\n")) {
      const t = line.trim();
      if (t && !t.startsWith("#")) { description = t.slice(0, 200); break; }
    }
  }
  if (!name) {
    const h = raw.match(/^#\s*(.+)$/m);
    if (h) name = h[1].trim().slice(0, 80);
  }
  return { name, description };
}
function findSkillDirsRecursive(root, maxDepth = 4) {
  const out = [];
  if (!dirExistsBin(root)) return out;
  const stack = [{ dir: root, depth: 0 }];
  while (stack.length) {
    const { dir, depth } = stack.pop();
    let entries = [];
    try { entries = fs.readdirSync(dir, { withFileTypes: true }); } catch { continue; }
    for (const ent of entries) {
      if (!ent.isDirectory() && !ent.isSymbolicLink()) continue;
      const full = path.join(dir, ent.name);
      if (skillFileExists(path.join(full, "SKILL.md"))) out.push(full);
      if (depth < maxDepth) stack.push({ dir: full, depth: depth + 1 });
    }
  }
  return out;
}
function discoverSkills(projectRoot) {
  const roots = [
    path.join(HUB_DIR, "skills"),
    path.join(HUB_DIR, "packages"),
    path.join(HOME_DIR, ".agents", "skills"),
    path.join(HOME_DIR, ".zcode", "skills"),
    path.join(HOME_DIR, ".claude", "skills"),
    path.join(HOME_DIR, ".config", "muse", "skills"),
    path.join(HOME_DIR, ".pi", "agent", "skills"),
    path.join(HOME_DIR, ".codex", "skills"),
  ];
  try {
    const agyRoot = path.join(HOME_DIR, ".t3", "userdata", "providers", "antigravity");
    for (const inst of listDirsBin(agyRoot)) roots.push(path.join(inst, "config", "skills"));
  } catch {}
  if (projectRoot) {
    roots.push(path.join(projectRoot, ".agents", "skills"));
    roots.push(path.join(projectRoot, ".claude", "skills"));
    roots.push(path.join(projectRoot, ".codex", "skills"));
  }
  const byId = new Map();
  function addDir(dir) {
    try {
      if (!skillFileExists(path.join(dir, "SKILL.md"))) return;
      const id = path.basename(dir);
      if (!id || id.startsWith(".")) return;
      const meta = parseSkillMeta(path.join(dir, "SKILL.md"));
      byId.set(id, { id, name: meta.name || id, description: meta.description || "", dir, path: path.join(dir, "SKILL.md") });
    } catch {}
  }
  for (const root of roots) {
    if (!dirExistsBin(root)) continue;
    const isPackages = root.endsWith("packages");
    if (isPackages) {
      for (const d of listDirsBin(root)) addDir(d);
      for (const d of findSkillDirsRecursive(root, 4)) addDir(d);
    } else {
      for (const d of listDirsBin(root)) addDir(d);
    }
  }
  return [...byId.values()].sort((a, b) => a.id.localeCompare(b.id));
}
function findSkill(slug, projectRoot) {
  if (typeof slug !== "string" || !slug.trim()) throw new Error("skill slug required");
  const s = slug.trim();
  if (s.includes("/") || s.includes("\\") || s.includes("..") || path.isAbsolute(s)) throw new Error("invalid skill slug: " + slug);
  const skills = discoverSkills(projectRoot);
  let found = skills.find((x) => x.id === s);
  if (found) return found;
  found = skills.find((x) => x.id.toLowerCase() === s.toLowerCase());
  if (found) return found;
  found = skills.find((x) => x.name === s);
  if (found) return found;
  throw new Error("skill not found: " + slug);
}
function readSkillFileLimited(dir, filePath, maxBytes) {
  const st = fs.statSync(filePath);
  if (!st.isFile()) throw new Error("not a file: " + filePath);
  const truncated = st.size > maxBytes;
  let buf;
  if (truncated) {
    const fd = fs.openSync(filePath, "r");
    try {
      buf = Buffer.alloc(maxBytes);
      const n = fs.readSync(fd, buf, 0, maxBytes, 0);
      buf = buf.subarray(0, n);
    } finally { fs.closeSync(fd); }
  } else {
    buf = fs.readFileSync(filePath);
  }
  return { content: buf.toString("utf8"), truncated, size: st.size };
}
