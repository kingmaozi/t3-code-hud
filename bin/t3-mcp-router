]) {
  try { hubSubagentsMod = require(cand); if (hubSubagentsMod) break; } catch {}
}
let hubTaskBoardMod = null;
for (const cand of [
  process.env.T3_HUB_TASK_BOARD ? path.resolve(process.env.T3_HUB_TASK_BOARD) : null,
  path.join(__dirname, "..", "src", "hub-task-board.cjs"),
